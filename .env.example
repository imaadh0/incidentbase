NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
METRICS_TOKEN=replace-with-at-least-32-characters
SHUTDOWN_TIMEOUT_MS=10000

# Worker infrastructure
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=10

# PostgreSQL (database service is introduced in Milestone 2)
POSTGRES_DB=incidentbase
POSTGRES_USER=incidentbase
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# OpenTelemetry is disabled locally unless an endpoint is supplied.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Web
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_OUTPUT_MODE=default

# Deployment image overrides used by Docker Compose on the VPS
WEB_IMAGE=incidentbase-web:local
API_IMAGE=incidentbase-api:local
WORKER_IMAGE=incidentbase-worker:local
