{
  "name": "@incidentbase/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src test",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:coverage": "vitest run --coverage --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@incidentbase/auth": "workspace:*",
    "@incidentbase/authorization": "workspace:*",
    "@incidentbase/config": "workspace:*",
    "@incidentbase/contracts": "workspace:*",
    "@incidentbase/database": "workspace:*",
    "@incidentbase/observability": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0"
  }
}
