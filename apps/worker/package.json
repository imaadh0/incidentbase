{
  "name": "@incidentbase/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src test",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:coverage": "vitest run --coverage --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@incidentbase/config": "workspace:*",
    "@incidentbase/contracts": "workspace:*",
    "@incidentbase/database": "workspace:*",
    "@incidentbase/observability": "workspace:*",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0"
  }
}
