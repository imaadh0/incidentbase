{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_OUTPUT_MODE", "NEXT_PUBLIC_API_BASE_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "passThroughEnv": [
        "DATABASE_TEST_URL",
        "API_TEST_DATABASE_URL",
        "API_TEST_RUNTIME_DATABASE_URL",
        "API_TEST_WORKER_DATABASE_URL",
        "WORKER_TEST_DATABASE_URL",
        "WORKER_TEST_REDIS_URL"
      ],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["build", "^build"],
      "passThroughEnv": [
        "DATABASE_TEST_URL",
        "API_TEST_DATABASE_URL",
        "API_TEST_RUNTIME_DATABASE_URL",
        "API_TEST_WORKER_DATABASE_URL",
        "WORKER_TEST_DATABASE_URL",
        "WORKER_TEST_REDIS_URL"
      ],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
